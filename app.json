{
  "expo": {
    "name": "ONGI",
    "slug": "ongi",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ongi",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.ongifamily.app",
      "icon": "./assets/images/icon.png",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleDevelopmentRegion": "ko",
        "CFBundleLocalizations": [
          "ko"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "온기",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        }
      },
      "usesAppleSignIn": true,
      "appleTeamId": "D7RV3R6ALY"
    },
    "android": {
      "package": "com.ongifamily.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.446390529009-4v2v53ig6830u7h6splbi79r34uaj3n7"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "가족과 나눌 사진을 고르기 위해 사진 보관함에 접근합니다.",
          "savePhotosPermission": false,
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "@react-native-seoul/kakao-login",
        {
          "kakaoAppKey": "192ed4743b2231b4497d471d24109438"
        }
      ],
      "expo-apple-authentication",
      "expo-notifications",
      "@react-native-seoul/kakao-login"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ec3cd923-bc7f-4dbe-910d-0156e115286f"
      }
    },
    "owner": "ddoniel"
  }
}
